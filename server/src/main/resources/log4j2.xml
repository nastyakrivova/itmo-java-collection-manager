<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    
    <Appenders>
        <!-- Консоль (только для INFO и выше) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%-5level] %logger{36} - %msg%n"/>
        </Console>
        
        <!-- Файл (сохраняем всё для отладки) -->
        <File name="File" fileName="logs/server.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] %msg%n"/>
        </File>
    </Appenders>
    
    <Loggers>
        <!-- Скрыть внутренние логи Log4j2 -->
        <Logger name="org.apache.logging.log4j" level="off"/>
        
        <!-- Наш пакет - INFO уровень (не выводим DEBUG) -->
        <Logger name="com.myorg.lab5" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>
        
        <!-- Корневой логгер -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
    
</Configuration>